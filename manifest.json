{
  "manifest_version": 3,
  "name": "Gmail OTP Fast Copier",
  "version": "1.0.0",
  "description": "Automatically detects incoming OTP and verification codes from Gmail with 1-click instant clipboard copy & desktop alerts.",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "clipboardWrite",
    "offscreen"
  ],
  "host_permissions": [
    "https://mail.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gmail OTP Fast Copier",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["gmail_content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
